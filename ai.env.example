# AI 서버 환경변수 목록 (TRD 7-3).
# 실제 값은 서버(EC2)에서 환경변수로 주입한다. API 키는 레포나 로컬 파일에 두지 않는다.

# 백엔드가 보낼 X-Internal-Token을 받아 줄 토큰 목록 (콤마 구분, 교체 중에만 2개). 32바이트 이상 무작위 값
AI_INTERNAL_TOKENS=

# upstage / fake (staging·CI 기본 fake). 부록 H-03에서 Upstage(Solar)로 결정
LLM_PROVIDER=fake
# Upstage API 키. 서버에서 주입한다
LLM_API_KEY=
# Upstage 채팅 모델 이름. 예: solar-pro4, solar-mini4
LLM_MODEL=

# 일일 토큰 상한 (TRD 16-9). 시연 당일 상향
LLM_DAILY_TOKEN_CAP=2000000

# on 이면 검수된 시연 캐시 사용 (TRD 16-8). prod 시연 기간만
DEMO_MODE=off

# AI 서버는 Redis DB 1 (일일 토큰 카운터 전용)
REDIS_URL=redis://redis:6379/1

# fake LLM에 넣을 가짜 지연 (부하 테스트). 기본 0
FAKE_LLM_LATENCY_MS=0
